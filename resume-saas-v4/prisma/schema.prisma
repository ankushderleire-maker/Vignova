generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String                   @unique
  password_hash           String
  full_name               String?
  role                    String                   @default("USER")
  created_at              DateTime                 @default(now())
  extensionSettings       Json?                    @default("{}")
  resetToken              String?
  resetTokenExpiry        DateTime?
  onboarding_done         Boolean                  @default(false)
  country                 String?                  @db.VarChar(2)
  status                  String                   @default("ACTIVE") @db.VarChar(16)
  generated_resumes       GeneratedResume[]
  job_applications        JobApplication[]
  linkedin_analyses       LinkedInAnalysis[]
  payments                Payment[]
  saved_interviews        SavedInterview[]
  exchange_rates          exchange_rates[]
  created_jobs            jobs[]                   @relation("JobCreatedBy")
  master_profiles         master_profiles[]
  payment_logs            payment_logs[]
  scan_jobs               ScanJob[]
  subscriptions           subscriptions?
  user_cooldown_overrides user_cooldown_overrides?
}

model Payment {
  id            String   @id @default(cuid())
  userId        String   @db.Uuid
  amount        Float
  currency      String   @default("USD")
  status        String
  paymentMethod String   @default("PAYPAL")
  transactionId String
  planType      String
  billingCycle  String
  createdAt     DateTime @default(now())
  user          users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model master_profiles {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  name        String   @default("Primary Profile")
  parsed_data Json?    @default("{}")
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, name])
  @@index([user_id])
}

model subscriptions {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @unique @db.Uuid
  plan_type             String    @default("FREE")
  billing_cycle         String    @default("MONTHLY")
  credits_remaining     Int       @default(3)
  credits_total         Int       @default(3)
  has_extension_access  Boolean   @default(false)
  has_multi_profile     Boolean   @default(false)
  has_unlimited_resumes Boolean   @default(false)
  starts_at             DateTime  @default(now())
  expires_at            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  user                  users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model JobApplication {
  id               String            @id @default(cuid())
  userId           String            @db.Uuid
  company          String
  jobTitle         String
  location         String?
  jobUrl           String?
  salary           String?
  description      String?
  status           String            @default("SAVED")
  matchScore       Int?              @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  source           String            @default("manual")
  sourceUrl        String?
  coverLetter      String?
  generatedResumes GeneratedResume[]
  user             users             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source])
  @@index([status])
}

model GeneratedResume {
  id            String         @id @default(cuid())
  userId        String         @db.Uuid
  jobId         String
  content       Json
  name          String
  createdAt     DateTime       @default(now())
  source        String         @default("manual")
  sourceUrl     String?
  extensionData Json?
  job           JobApplication @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user          users          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@index([createdAt])
  @@index([source])
}

model plan_configs {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_type                 String   @unique
  name                      String
  description               String
  monthly_price             Float    @default(0)
  credits                   Int      @default(3)
  has_extension_access      Boolean  @default(false)
  has_multi_profile         Boolean  @default(false)
  has_unlimited_resumes     Boolean  @default(false)
  resume_creation_label     String   @default("3 resumes/month")
  ai_optimization_label     String   @default("Basic")
  templates_label           String   @default("5 templates")
  support_label             String   @default("Community")
  is_popular                Boolean  @default(false)
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt
  has_linkedin_optimization Boolean  @default(false)
  has_interview_prep        Boolean  @default(false)
}

model jobs {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  company             String
  location            String?
  description         String?
  apply_url           String?
  source              String?
  date_posted         DateTime?
  created_at          DateTime  @default(now())
  employment_type     String?   @db.VarChar(50)
  remote              Boolean   @default(false)
  salary_max          Int?
  salary_min          Int?
  source_type         String?   @db.VarChar(64)
  location_normalized String?
  experience_level    String?   @db.VarChar(32)
  job_hash            String?   @unique(map: "jobs_job_hash_idx")
  created_by_user_id  String?   @db.Uuid
  scraped_at          DateTime?
  created_by_user     users?    @relation("JobCreatedBy", fields: [created_by_user_id], references: [id])

  @@unique([title, company, location])
  @@unique([title, company, location], map: "jobs_dedup_idx")
  @@index([title])
  @@index([location])
  @@index([location_normalized])
  @@index([company])
  @@index([experience_level])
  @@index([source])
  @@index([date_posted])
  @@index([created_by_user_id])
  @@index([created_at])
}

model ScanJob {
  id           String    @id @default(cuid())
  userId       String    @map("user_id") @db.Uuid
  sources      String[]  @default([])
  companies    String[]  @default([])
  keywords     String[]  @default([])
  locations    String[]  @default([])
  status       String    @default("PENDING")
  jobsFetched  Int       @default(0) @map("jobs_fetched")
  jobsInserted Int       @default(0) @map("jobs_inserted")
  duplicates   Int       @default(0)
  errors       Int       @default(0)
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId], map: "scan_jobs_user_idx")
  @@map("scan_jobs")
}

model SourceRegistry {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_name String
  ats_type     String    @db.VarChar(64)
  endpoint_url String    @unique(map: "sources_endpoint_url_idx")
  priority     Int       @default(100)
  last_scraped DateTime?
  active       Boolean   @default(true)

  @@index([ats_type])
  @@index([active, priority])
  @@map("sources")
}

model LinkedInAnalysis {
  id               String   @id @default(cuid())
  userId           String   @db.Uuid
  linkedinUrl      String
  overallScore     Float?
  sectionScores    Json?
  recommendations  Json?
  optimizedContent Json?
  rawProfileData   Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedInterview {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  jobId     String?
  source    String
  questions Json
  createdAt DateTime @default(now())
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model exchange_rates {
  id              String    @id @default(cuid()) @db.VarChar(30)
  base_currency   String?   @default("USD") @db.VarChar(10)
  target_currency String?   @default("INR") @db.VarChar(10)
  rate            Float
  updated_by      String?   @db.Uuid
  updated_at      DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  users           users?    @relation(fields: [updated_by], references: [id], onUpdate: NoAction)
}

model payment_logs {
  id                 String    @id @default(cuid()) @db.VarChar(30)
  user_id            String    @db.Uuid
  product_id         String    @db.VarChar(50)
  country            String    @db.VarChar(2)
  currency           String    @db.VarChar(10)
  usd_price          Float
  exchange_rate_used Float?
  final_amount       Float
  razorpay_order_id  String?   @db.VarChar(100)
  payment_status     String    @db.VarChar(20)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  user               users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model migrations {
  filename   String    @id
  applied_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("_migrations")
}

model admin_extension_settings {
  id                String   @id
  extension_id      String   @default("")
  extension_version String   @default("1.0.0")
  extension_name    String   @default("Vignova Extension")
  install_url       String   @default("")
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_by        String?  @db.Uuid
}

model admin_scan_settings {
  id                     String   @id
  cooldown_hours_default Int      @default(24)
  scan_enabled           Boolean  @default(true)
  scan_disabled_reason   String?
  updated_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_by             String?  @db.Uuid
}

model admin_audit_logs {
  id          BigInt   @id @default(autoincrement())
  admin_id    String?  @db.Uuid
  admin_email String?
  action      String   @db.VarChar(64)
  target_type String?  @db.VarChar(32)
  target_id   String?
  details     Json?
  ip          String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)])
  @@index([admin_id])
  @@index([action])
}

model user_cooldown_overrides {
  user_id              String    @id @db.Uuid
  cooldown_hours       Int?
  scan_disabled        Boolean   @default(false)
  scan_disabled_reason String?
  expires_at           DateTime? @db.Timestamptz(6)
  updated_by           String?   @db.Uuid
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)
  users                users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}
