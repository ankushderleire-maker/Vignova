# ======================================================================
# resume-saas-v4/.env — Next.js dashboard
# ----------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local` for local dev) and fill in
# real values. NEVER commit the real .env.
#
# Rule of thumb:
#   * Docker (compose)  → DATABASE_URL=...@db:5432/...
#   * Local `npm run dev` on your laptop → DATABASE_URL=...@localhost:5432/...
# ======================================================================

# ---------- Database ----------
DATABASE_URL="postgresql://postgres:<DB_PASSWORD>@db:5432/resume_ai_saas"

# ---------- NextAuth ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=<REPLACE_ME_BASE64_32>
NEXTAUTH_URL=https://app.vignova.io

# ---------- Adzuna ----------
ADZUNA_APP_ID=<REPLACE_ME>
ADZUNA_APP_KEY=<REPLACE_ME>

# ---------- Browser extension ----------
EXTENSION_JWT_SECRET=<REPLACE_ME_RANDOM_32_BYTES>
# Inside Docker use `http://backend:8000`. For local dev use
# `http://localhost:8000`.
AI_BACKEND_URL=http://backend:8000

# ---------- Internal Next.js ↔ FastAPI bridge ----------
# MUST match INTERNAL_API_KEY in Backend/Full_Backend/.env
INTERNAL_API_KEY=<REPLACE_ME_HEX_32>

# Optional: if set, admin → "Run ATS ingestion" URL uses this base URL
# instead of defaulting to https://api.vignova.io
PUBLIC_BACKEND_URL=https://api.vignova.io

# ---------- SMTP (password-reset emails) ----------
SMTP_HOST=<REPLACE_ME>
SMTP_PORT=587
SMTP_USER=<REPLACE_ME>
SMTP_PASS=<REPLACE_ME>
SMTP_FROM="Vignova <support@vignova.io>"

# ---------- OAuth providers ----------
# Google
GOOGLE_CLIENT_ID=<REPLACE_ME>
GOOGLE_CLIENT_SECRET=<REPLACE_ME>
# LinkedIn
LINKEDIN_CLIENT_ID=<REPLACE_ME>
LINKEDIN_CLIENT_SECRET=<REPLACE_ME>

# ---------- Gemini ----------
GEMINI_API_KEY=<REPLACE_ME>
