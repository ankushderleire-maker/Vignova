# ======================================================================
# Root .env — shared by docker-compose and the Next.js dashboard container
# ----------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit the real
# .env — it is already excluded via .gitignore.
# ======================================================================

# ---------- Database ----------
# For docker-compose deploys, hostname MUST be `db` (the service name),
# not `localhost`. For local `npm run dev` use `.env.local` in
# resume-saas-v4/ with `@localhost`.
DATABASE_URL="postgresql://postgres:<DB_PASSWORD>@db:5432/resume_ai_saas"
DB_USER=postgres
DB_PASSWORD=<REPLACE_ME_STRONG_PASSWORD>
DB_NAME=resume_ai_saas

# ---------- NextAuth ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=<REPLACE_ME_BASE64_32>
# Public URL of the dashboard in production
NEXTAUTH_URL=https://app.vignova.io

# ---------- Adzuna (Indeed feed) ----------
# https://developer.adzuna.com/
ADZUNA_APP_ID=<REPLACE_ME>
ADZUNA_APP_KEY=<REPLACE_ME>

# ---------- Browser extension ----------
EXTENSION_JWT_SECRET=<REPLACE_ME_RANDOM_32_BYTES>
# Hostname of the FastAPI container inside the compose network
AI_BACKEND_URL=http://backend:8000

# ---------- Gemini ----------
GEMINI_API_KEY=<REPLACE_ME>
