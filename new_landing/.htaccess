# Hostinger / Apache / LiteSpeed. A static site needs no application server.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Normalize known legacy HTML forms without redirecting missing URLs home.
  # THE_REQUEST prevents a loop when DirectoryIndex serves index.html internally.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s] [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)\.html$ /$1/ [R=301,L,NE]

  # Keep the existing HTTPS apex canonical host. Local previews are unaffected.
  RewriteCond %{HTTP_HOST} ^www\.vignova\.io$ [NC]
  RewriteRule ^ https://vignova.io%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^vignova\.io$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://vignova.io%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml application/json application/manifest+json
</IfModule>
