{
    "manifest_version": 3,
    "name": "Vignova - Your Career AI Assistant",
    "short_name": "Vignova",
    "version": "2.0.0",
    "description": "AI career copilot: tailor resumes, auto-fill applications, and track jobs with Kanban.",
    "minimum_chrome_version": "116",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Vignova \u2013 Career AI",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        }
    },
    "background": {
        "service_worker": "background/service-worker.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.linkedin.com/jobs/*",
                "*://linkedin.com/jobs/*"
            ],
            "js": [
                "utils/api.js",
                "utils/localScorer.js",
                "utils/score.js",
                "content/matchPanel.js",
                "content/overlay.js",
                "content/linkedin.js"
            ],
            "css": [
                "styles/button.css",
                "content/overlay.css",
                "content/matchPanel.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.indeed.com/*",
                "*://indeed.com/*"
            ],
            "js": [
                "utils/api.js",
                "utils/localScorer.js",
                "utils/score.js",
                "content/matchPanel.js",
                "content/overlay.js",
                "content/indeed.js"
            ],
            "css": [
                "styles/button.css",
                "content/overlay.css",
                "content/matchPanel.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/jobExtractor.js",
                "agent/observer.js",
                "agent/atsProfiles.js",
                "agent/ruleEngine.js",
                "agent/atsDetector.js",
                "agent/planner.js",
                "agent/executor.js",
                "agent/agentLoop.js",
                "content/fileInterceptor.js",
                "content/autoapply.js",
                "content/dashboard_bridge.js"
            ],
            "run_at": "document_idle",
            "all_frames": true,
            "match_about_blank": true
        }
    ],
    "permissions": [
        "storage",
        "activeTab",
        "tabs",
        "scripting",
        "cookies",
        "clipboardWrite"
    ],
    "host_permissions": [
        "https://app.vignova.io/*",
        "https://api.vignova.io/*",
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.workday.com/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*",
                "popup/*",
                "icons/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}