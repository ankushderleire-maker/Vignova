{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "LandingCode"],
      "port": 3000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
