# ======================================================================
# Backend/Full_Backend/.env — FastAPI service
# ----------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit the
# real .env.
# ======================================================================

# ---------- LLM providers ----------
GEMINI_API_KEY=<REPLACE_ME>
SARVAM_API_KEY=<REPLACE_ME>

# Options: GEMINI or SARVAM
RESUME_GENERATION_MODEL=GEMINI
ATS_SCORE_MODEL=SARVAM

# ---------- Database ----------
# Inside Docker use `@db:5432`. For a laptop dev run use `@localhost:5432`.
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db:5432/resume_ai_saas

# ---------- Cron / worker ----------
# Format: minute hour day month weekday  (reference only)
CRON_SCHEDULE=0 */6 * * *
LOG_LEVEL=INFO
BATCH_SIZE=50

# ---------- Internal auth ----------
# MUST match resume-saas-v4/.env:INTERNAL_API_KEY
INTERNAL_API_KEY=<REPLACE_ME_HEX_32>
INGEST_API_KEY=<REPLACE_ME_HEX_32>

# ---------- CORS ----------
# Comma-separated list of origins the browser may call the API from.
# The backend defaults to http://localhost:3000 if this is unset — good
# for dev, wrong for prod.
ALLOWED_ORIGINS=https://app.vignova.io,https://vignova.io

# ---------- Ollama ----------
# Inside Docker use `http://ollama:11434`. For a laptop dev run use
# `http://localhost:11434`.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# ---------- Adzuna (Indeed feed) ----------
# https://developer.adzuna.com/
ADZUNA_APP_ID=<REPLACE_ME>
ADZUNA_APP_KEY=<REPLACE_ME>
# Countries to hit when the search query has no location — covered by the
# free Adzuna plan.
ADZUNA_FALLBACK_COUNTRIES=us,gb,in,ie
